# Backend environment. Copy to .env (or export) for non-docker runs.
# For local development you can skip this file and use SPRING_PROFILES_ACTIVE=local.
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/blog_cms
SPRING_DATASOURCE_USERNAME=blog_cms
SPRING_DATASOURCE_PASSWORD=change-me

# Admin sign-in (bcrypt hash of the password — see the root README) and token signing key.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH='$2a$10$...'
JWT_SECRET=at-least-32-characters-of-random-text
# Session length (Spring duration format)
JWT_TTL=8h

# Nextcloud media storage (use a dedicated Nextcloud app password)
NEXTCLOUD_URL=https://nextcloud.example.com
NEXTCLOUD_USERNAME=blogcms
NEXTCLOUD_PASSWORD=replace-with-nextcloud-app-password
NEXTCLOUD_REMOTE_DIRECTORY=/BlogCMS
