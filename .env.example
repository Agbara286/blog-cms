# Used by docker-compose.yml. Copy to .env and adjust. Never commit .env.
POSTGRES_DB=blog_cms
POSTGRES_USER=blog_cms
POSTGRES_PASSWORD=change-me

# Admin sign-in. The password is stored only as a bcrypt hash; generate one with:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 10 "" 'your-password' | tr -d ':\n'
# Keep the single quotes: the hash contains "$", which Compose would otherwise expand.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH='$2a$10$wBISilJqYrK8S7ddSh4zhuWUnPjn24l5hToR4l4lIkKH/WG.fsKI6'

# Signs session tokens; at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Host ports
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Session cookie HTTPS-only flag. Keep false for this plain-HTTP stack; true behind HTTPS.
SESSION_COOKIE_SECURE=false

# Nextcloud media storage (use a dedicated Nextcloud app password)
NEXTCLOUD_URL=https://nextcloud.example.com
NEXTCLOUD_USERNAME=blogcms
NEXTCLOUD_PASSWORD=replace-with-nextcloud-app-password
NEXTCLOUD_REMOTE_DIRECTORY=/BlogCMS
